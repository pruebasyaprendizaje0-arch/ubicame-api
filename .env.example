# Entorno
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos PostgreSQL compartida (Recurso ubicame-postgres en Coolify)
DATABASE_URL=postgresql://ubicame_user:ubicame_pass@localhost:5432/ubicame_core?schema=public

# Autenticación JWT
JWT_SECRET=super-secret-key-replace-with-secure-random-string
JWT_EXPIRES_IN=7d

# CORS (Orígenes permitidos separados por coma)
CORS_ORIGINS=https://api.ubicame.cc,https://menuqr.ubicame.cc,https://misreservaciones.ubicame.cc,http://localhost:3000,http://localhost:5173