# Entorno
NODE_ENV=development
PORT=4000

# Base de datos PostgreSQL compartida
DATABASE_URL=postgresql://ubicame_user:ubicame_pass@localhost:5432/ubicame_db?schema=public

# Autenticación JWT
JWT_SECRET=super-secret-key-replace-with-secure-random-string
JWT_EXPIRES_IN=7d

# CORS (Orígenes permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://menuqr.ubicame.cc,https://misreservaciones.ubicame.cc